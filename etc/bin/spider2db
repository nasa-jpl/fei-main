#!/usr/bin/perl -w
#
### =============================================================== ###
#                                                                     #
#  The File Exchange Interface (FEI) Dracula Client Bootstrap Script  #
#                                                                     #
#  Function:                                                          #
#  Launches the Spider Hibernate Persistance app.                     #
#                                                                     #
#  Assumptions:                                                       #
#  - Perl 5 is installed on the target platform in /usr/bin/perl      #
#  - The $FEI5 environment variable must point to the directory       #
#    containing the domain.fei, the SSL certificate, and              #
#    mdmsconfig.pm files.                                             #
#                                                                     #
#  Copyright (c) 2006 by the California Institute of Technology.      #
#  ALL RIGHTS RESERVED.  United States Government Sponsorship         #
#  acknowledged. Any commercial use must be negotiated with the       #
#  Office of Technology at the California Institute of Technology.    #
#                                                                     #
#  The technical data in this document (or file) is controlled for    #
#  export under the Export Administration Regulations (EAR), 15 CFR,  #
#  Parts 730-774. Violations of these laws are subject to fines and   #
#  penalties under the Export Administration Act.                     #
#                                                                     #
#                                                                     #
#  Created:                                                           #
#  Apr. 21, 2005 by C. Radulescu {Costin.Radulescu@jpl.nasa.gov}      #
#                                                                     #
#  Modifications:                                                     #
#                                                                     #
### =============================================================== ###
#
# $Id: spider2db,v 1.5 2006/10/03 02:18:19 ntt Exp $
#

use strict;
use File::Spec;
die "[ERROR] FEI5 environment variable is not set.\n" unless $ENV{FEI5};
require File::Spec->catdir($ENV{FEI5}, 'mdmsconfig.pm');

#umask 077;

#set $debug to 1 to turn on trace info
my $debug=0;

my $javaCmd = &getCmd ($debug);
my $classpath = $ENV{CLASSPATH} ? "$ENV{FEI5}/hibernate.properties:$ENV{CLASSPATH}" : "$ENV{FEI5}/hibernate.properties";
my $url = 'file://'.File::Spec->catdir($ENV{FEI5},'mdms.lcf');
my @args = &getJVMArgsCheckGUI($classpath, 1, $debug);
                                                                              
push @args, "-Dlog4j.configuration=$url";
push @args, "-Dlog4j.configuratorClass=org.apache.log4j.xml.DOMConfigurator";
push @args, "-Dmdms.user.operation=spider.util.dracula";
push @args, "-Djava.naming.factory.initial=org.jnp.interfaces.NamingContextFactory";
push @args, "-Djava.naming.provider.url=jnp://$ENV{JAVA_NAMING_HOST}:1099";
push @args, "-Djava.naming.factory.url.pkgs=org.jboss.naming:org.jnp.interfaces";
push @args, "jpl.mipl.mdms.FileService.spider.util.SpiderMsgToDb";
push @args, @ARGV;
                                                                              
print "\n $javaCmd @args\n\n" if ($debug);
my $returnValue = system $javaCmd, @args;
exit $returnValue >> 8;
